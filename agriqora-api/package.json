{
  "name": "agriqora-api",
  "version": "1.1.0",
  "description": "AgriQora agricultural marketplace API backed by PostgreSQL and Prisma",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx src/scripts/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx src/scripts/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@solana/web3.js": "^1.99.0",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.0",
    "prisma": "^6.16.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
