# URL of the AgriQora API (the agriqora-api backend), no trailing slash.
#
# Leave EMPTY while developing: "npm run dev" forwards /api to
# http://localhost:3000 automatically (see vite.config.ts).
#
# For production, set it to your deployed API, for example:
#   VITE_API_URL=https://api.yourdomain.com
# and put this site's address in the backend's CORS_ORIGIN.
# Vite reads this at BUILD time, so rebuild after changing it.
VITE_API_URL=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Set to the deployed devnet program address; leave empty until deployment.
VITE_SOLANA_PROGRAM_ID=
